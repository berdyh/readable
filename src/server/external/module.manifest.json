{
  "schemaVersion": 1,
  "id": "server.external",
  "parent": "server",
  "path": "src/server/external",
  "goal": "Enriches citations from Semantic Scholar, singly or as an ingest-time batch.",
  "owns": ["src/server/external"],
  "interface": {
    "entrypoint": "index.ts",
    "exports": [
      "enrichCitation",
      "enrichCitationsBatch",
      "CitationEnrichmentInput",
      "SemanticScholarPaper"
    ]
  },
  "uses": [
    {
      "module": "server.config",
      "via": "getTimeout / getUrl"
    }
  ],
  "constraints": ["outbound lookups", "response caching", "rate-limit backoff", "single-flight"],
  "checks": ["pnpm vitest run src/server/external"]
}
