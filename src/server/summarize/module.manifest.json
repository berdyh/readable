{
  "schemaVersion": 1,
  "id": "server.summarize",
  "parent": "server",
  "path": "src/server/summarize",
  "goal": "Produces a teaching-contract explanation of a stored paper (hook, claim, mechanism, evidence, glossary).",
  "owns": ["src/server/summarize"],
  "interface": {
    "entrypoint": "index.ts",
    "exports": ["summarizePaper"]
  },
  "uses": [
    {
      "module": "server.db",
      "via": "fetchPaperChunksByPaperId"
    },
    {
      "module": "server.explain",
      "via": "loadPersonaSplit / routeCitations / validateSourceLabel"
    },
    {
      "module": "server.llm",
      "via": "generateJson"
    },
    {
      "module": "server.ingest",
      "via": "fetchArxivMetadata"
    },
    {
      "module": "server.persona",
      "via": "recordPersonaSignals"
    },
    {
      "module": "server.llm-config",
      "via": "getSystemPrompt"
    },
    {
      "module": "server.text",
      "via": "truncateWithEllipsis"
    }
  ],
  "constraints": ["context assembly", "structured summary output"],
  "checks": ["pnpm vitest run src/server/e2e"]
}
