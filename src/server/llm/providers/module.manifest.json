{
  "schemaVersion": 1,
  "id": "server.llm.providers",
  "parent": "server.llm",
  "path": "src/server/llm/providers",
  "goal": "Adapts each upstream model API to one provider interface.",
  "owns": ["src/server/llm/providers"],
  "interface": {
    "entrypoint": "(via ../index.ts)",
    "exports": [
      "OpenAiProvider",
      "AnthropicProvider",
      "GeminiProvider",
      "OpenRouterProvider",
      "LocalCodingAgentProvider"
    ]
  },
  "uses": [
    {
      "module": "server.llm-config",
      "via": "getModel"
    },
    {
      "module": "server.config",
      "via": "getTimeout"
    }
  ],
  "constraints": ["one class per upstream API", "request/response translation"],
  "checks": ["pnpm vitest run src/server/llm/providers"]
}
