{
  "name": "readable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepare": "node scripts/prepare.mjs",
    "lint-staged": "lint-staged",
    "test:stores": "tsx scripts/test-stores.ts",
    "test:api": "tsx scripts/test-api-endpoints.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "embeddings:probe": "tsx scripts/probe-embedding.ts",
    "setup": "tsx scripts/setup.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm modules:check",
    "modules:generate": "node scripts/modules/generate-agents.mjs",
    "modules:check": "node scripts/modules/check.mjs && node scripts/modules/generate-agents.mjs --check"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.1",
    "@tiptap/core": "^2.6.6",
    "@tiptap/extension-bubble-menu": "^2.6.6",
    "@tiptap/extension-character-count": "^2.6.6",
    "@tiptap/extension-color": "^2.6.6",
    "@tiptap/extension-highlight": "^2.6.6",
    "@tiptap/extension-horizontal-rule": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-text-style": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "@tiptap/suggestion": "^2.6.6",
    "@types/marked": "^6.0.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^11.0.0",
    "@ungap/with-resolvers": "^0.1.0",
    "@vercel/speed-insights": "^1.2.0",
    "cheerio": "^1.1.2",
    "clsx": "2.1.1",
    "domhandler": "^5.0.3",
    "dotenv": "^17.2.3",
    "fast-diff": "^1.3.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.471.0",
    "marked": "^16.4.1",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.20.0",
    "posthog-js": "^1.280.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-pdf": "10.2.0",
    "react-pdf-highlighter": "7.0.0",
    "tippy.js": "^6.3.7",
    "turndown": "^7.2.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfjs-dist": "^2.10.378",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^2.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{css,md,mdx,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "packageManager": "pnpm@9.12.0"
}
