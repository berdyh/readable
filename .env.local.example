# Readable - Environment Variables Example
# Copy this file to .env.local and fill in your API keys

# ============================================
# Clerk Authentication (REQUIRED for auth UI)
# ============================================
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ============================================
# LLM Provider API Keys (REQUIRED for remote API providers)
# ============================================
# At minimum, you need ONE of these API keys when using a remote provider.
# Local development can instead use LLM_PROVIDER=coding-agent below.
# Run `pnpm setup` for an interactive picker that detects what's available
# and writes the right values into this file.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-v1-...

# Multi-key forms (priority chain — see src/server/llm/routing/env-keys.ts):
# READABLE_LIVE_OPENAI_KEY=...   # short-circuit override; returns alone
# OPENAI_API_KEYS=key1,key2,...  # rotation list
# OPENAI_API_KEY_1=...           # numbered variants merged into the chain

# Default LLM Provider (openai, anthropic, gemini, openrouter, or coding-agent).
# OpenRouter is the default — it has a free tier (Llama 3.3 70B,
# DeepSeek v3.1, Qwen3 235B) and an OpenAI-compatible API, so a fresh
# install with just OPENROUTER_API_KEY works.
LLM_PROVIDER=openrouter

# Local coding-agent mode for development. Requests are sent to safe installed
# coding CLIs in order, with OpenClaw-style fallback on failed/empty attempts.
# The default local fallback is Codex CLI only. Agent processes run from an
# isolated temp directory with throwaway HOME/TMPDIR/XDG dirs, so app secrets
# and your normal config paths are not forwarded to user-prompted CLI sessions.
# LLM_PROVIDER=coding-agent
# LLM_ALLOWED_PROVIDERS=
# LLM_LOCAL_AGENTS=codex-cli
# LLM_LOCAL_AGENT_TIMEOUT_MS=180000
# LLM_LOCAL_AGENT_ENV_ALLOWLIST=
#
# Optional command overrides. Useful when your shell command is an npx wrapper
# but you want the dev server to use an already-installed/cached executable.
# LLM_AGENT_CLAUDE_CODE_COMMAND=claude
# LLM_AGENT_CODEX_COMMAND=/home/you/.npm/_npx/<id>/node_modules/.bin/codex
# LLM_AGENT_CODEX_AUTH_FILE=/home/you/.codex/auth.json
# LLM_AGENT_CODEX_MODEL=gpt-5.5
# LLM_AGENT_CODEX_REASONING_EFFORT=xhigh
#
# Tool-capable built-ins such as Gemini CLI and opencode are skipped unless
# you explicitly opt in for local-only use with an unsafe flag or custom argv.
# Prefer custom argv when the CLI supports no-tool/read-only flags.
# LLM_LOCAL_AGENT_ALLOW_UNSAFE=0
# LLM_AGENT_GEMINI_COMMAND=gemini
# LLM_AGENT_GEMINI_ALLOW_UNSAFE=1
# LLM_AGENT_OPENCODE_COMMAND=/home/you/.npm/_npx/<id>/node_modules/opencode-linux-x64/bin/opencode
# LLM_AGENT_OPENCODE_ARGS_JSON=["run","--no-summary","{prompt}"]
#
# Optional argv override per agent. JSON array values can contain {prompt},
# {cwd}, and {output}. Antigravity requires this if used headlessly.
# LLM_AGENT_ANTIGRAVITY_COMMAND=antigravity
# LLM_AGENT_ANTIGRAVITY_ARGS_JSON=["run","--prompt","{prompt}"]

# Optional fallback chain — when set, the OpenClaw-style routing layer is
# engaged. Comma-separated providers tried left to right on rate-limit /
# auth / timeout / billing errors. Leave blank for legacy single-provider.
# LLM_ALLOWED_PROVIDERS=openrouter,openai,anthropic

# OpenRouter attribution headers (optional app attribution; defaults are sane).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://github.com/your-org/your-fork
# OPENROUTER_X_TITLE=Readable

# Per-task model overrides (free models for OpenRouter testing):
# OPENROUTER_QA_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-chat-v3.1:free
# OPENROUTER_INLINE_MODEL=qwen/qwen3-235b-a22b:free
# OpenRouter-native model fallback. Values are raw OpenRouter model IDs for
# the request body's `models` array, not internal `openrouter/<model>` refs.
# Set in Vercel as needed:
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ============================================
# Postgres Configuration (REQUIRED)
# ============================================
# Source of truth for papers, chunks, figures, citations, persona
# concepts, and the interactions log. Provide either DATABASE_URL or
# the discrete POSTGRES_* variables below. The schema is applied automatically the first
# time the server runs against the database (see scripts/db-migrate.ts).
DATABASE_URL=postgresql://readable:readable@localhost:5432/readable
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=readable
# POSTGRES_USER=readable
# POSTGRES_PASSWORD=readable
# POSTGRES_SSL=false
# POSTGRES_POOL_MAX=10
# POSTGRES_STATEMENT_TIMEOUT_MS=20000
# POSTGRES_IDLE_TIMEOUT_MS=30000

# ============================================
# Qdrant Configuration (REQUIRED)
# ============================================
# Vector store for paper-chunk embeddings. The collection is created on demand
# the first time the ingest pipeline runs.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key
# QDRANT_COLLECTION=paper_chunks
# QDRANT_VECTOR_SIZE=1536
# QDRANT_DISTANCE=Cosine
# QDRANT_TIMEOUT_MS=20000

# ============================================
# Embeddings Configuration (REQUIRED for vector search)
# ============================================
# Pluggable. Each provider gets its own Qdrant collection sized to that
# model's native dimension — no vector-space mixing. Switching providers
# means re-ingesting the corpus into the matching collection.
# Default auto mode uses OpenRouter when OPENROUTER_API_KEY exists, otherwise
# it falls back to the built-in local hash embedder for local tests.
EMBEDDING_PROVIDER=auto

# OpenAI embedder (uses OPENAI_API_KEY above):
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# OpenRouter embedder (uses OPENROUTER_API_KEY above; multimodal):
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_DIMENSIONS=2048   # run `pnpm embeddings:probe` to confirm

# Local fallback embedder (no network or API key; intended for local/dev tests):
# LOCAL_EMBEDDING_MODEL=hash-v1
# LOCAL_EMBEDDING_DIMENSIONS=384

# Shared:
# EMBEDDING_TIMEOUT_MS=30000

# ============================================
# Optional: Routing-layer state
# ============================================
# Where the auth-profile + cooldown JSON files live. Defaults to
# ~/.readable/agents/<agentId>/. Override for tests or when sharing
# state across deployments.
# READABLE_HOME=~/.readable
# READABLE_STATE_DIR=/var/lib/readable

# ============================================
# Semantic Scholar API (citation enrichment)
# ============================================
# Enriches paper_citations rows with Semantic Scholar metadata when QA
# returns cited references. Public endpoint works without a key (rate-
# limited); set the key for higher quotas. Keys: https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_KEY=your-semantic-scholar-key
# SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
# SEMANTIC_SCHOLAR_TIMEOUT_MS=10000

# ============================================
# Optional: arXiv Configuration
# ============================================
# ARXIV_CONTACT_EMAIL=your-email@example.com
# ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
# AR5IV_BASE_URL=https://ar5iv.org/html

# ============================================
# Optional: Ingestion Services (OCR fallback for image-only PDFs)
# ============================================
# Without these, ingest works on text PDFs via PDF.js + ar5iv HTML.
# Set the OCR vars only if you need to handle scanned / image-only PDFs.
# DEEPSEEK_OCR_URL=https://your-ocr-endpoint
# RUNPOD_API_KEY=your-runpod-key
# RUNPOD_ENDPOINT_ID=your-endpoint-id
# ENABLE_OCR_FALLBACK=true
# INGEST_PDF_TEXT_THRESHOLD=1000

# ============================================
# Optional: OpenAI Organization/Project
# ============================================
# OPENAI_ORGANIZATION=org-...
# OPENAI_PROJECT=proj-...

# ============================================
# Optional: Model Overrides
# ============================================
# Models are automatically selected based on task type (see src/server/llm-config/models.json)
# Only override if you need different models than the defaults:
# OPENAI_QA_MODEL=gpt-4o
# ANTHROPIC_SUMMARY_MODEL=claude-3-5-sonnet-20241022
# GEMINI_QA_MODEL=gemini-1.5-pro

# ============================================
# Notes - Configuration Defaults
# ============================================
# Most configuration has sensible defaults defined in src/server/config/defaults.ts
# Only set these if you need to override the defaults:
#
# Timeouts (milliseconds): {SERVICE}_TIMEOUT_MS
#   Examples: OPENAI_TIMEOUT_MS=90000, SEMANTIC_SCHOLAR_TIMEOUT_MS=15000
#   See defaults.ts for all available timeout keys and default values
#
# API Base URLs: {SERVICE}_API_BASE_URL or {SERVICE}_URL
#   Examples: OPENAI_API_BASE_URL=https://proxy.example.com/v1
#   Only needed for custom endpoints (proxy servers, self-hosted)
#   See defaults.ts for all default URLs
