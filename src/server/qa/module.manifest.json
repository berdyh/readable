{
  "schemaVersion": 1,
  "id": "server.qa",
  "parent": "server",
  "path": "src/server/qa",
  "goal": "Answers a question about a paper with grounded citations.",
  "owns": [
    "src/server/qa"
  ],
  "interface": {
    "entrypoint": "index.ts",
    "exports": [
      "answerPaperQuestion",
      "loadQuestionEvidence",
      "parseQuestionSelection"
    ]
  },
  "uses": [
    {
      "module": "server.search",
      "via": "hybridPaperChunkSearch"
    },
    {
      "module": "server.llm",
      "via": "generateJson"
    },
    {
      "module": "server.explain",
      "via": "loadPersonaSplit / routeCitations / validateSourceLabel"
    },
    {
      "module": "server.persona",
      "via": "recordPersonaSignals"
    },
    {
      "module": "server.db",
      "via": "fetchChunksByIds"
    },
    {
      "module": "server.llm-config",
      "via": "getSystemPrompt"
    },
    {
      "module": "server.text",
      "via": "truncateWithEllipsis"
    }
  ],
  "constraints": [
    "evidence assembly",
    "grounded answering",
    "citation validity"
  ],
  "checks": [
    "pnpm vitest run src/server/qa"
  ]
}
