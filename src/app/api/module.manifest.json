{
  "schemaVersion": 1,
  "id": "web.api",
  "parent": "web",
  "path": "src/app/api",
  "goal": "Adapts HTTP requests to the server modules that do the work.",
  "owns": ["src/app/api"],
  "interface": {
    "entrypoint": "(Next.js file-based routes)",
    "exports": []
  },
  "uses": [
    {
      "module": "server.auth",
      "via": "requireAuthenticatedUserId"
    },
    {
      "module": "server.qa",
      "via": "answerPaperQuestion"
    },
    {
      "module": "server.summarize",
      "via": "summarizePaper"
    },
    {
      "module": "server.ingest",
      "via": "ingestPaper"
    },
    {
      "module": "server.editor",
      "via": "summarizeSelection"
    },
    {
      "module": "server.chat",
      "via": "toApiMessage"
    },
    {
      "module": "server.persona",
      "via": "recordExposureSignal"
    },
    {
      "module": "server.db",
      "via": "createChatSession"
    },
    {
      "module": "server.llm.routing",
      "via": "classifyFailoverSignal"
    }
  ],
  "constraints": ["auth", "request validation", "response shaping"],
  "checks": ["pnpm vitest run src/app/api"],
  "stubs": [
    {
      "id": "web.api.is-a-layer-not-a-module",
      "why": "'Handles HTTP routing' is a technical role, not a job — a change to Q&A cuts across api/qa/, server/qa/, and web.chat at once. Normally route files belong to the feature module they expose, but Next.js file-based routing pins them to src/app/api/** and makes that physically impossible.",
      "action": "accept-and-document",
      "paths": ["src/app/api"],
      "contract": {
        "target": "Handlers stay thin — auth, validate, delegate, shape. Logic that grows here belongs in a server module.",
        "validation": ["pnpm vitest run src/app/api"]
      }
    }
  ]
}
